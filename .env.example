# Copia este archivo como .env y llena los valores. (El .env está en .gitignore: no se sube a git.)

# OCR.space: llaves gratis en https://ocr.space/ocrapi
# Puedes poner varias separadas por coma: si una se agota, se usa la siguiente.
EXPO_PUBLIC_OCR_SPACE_KEY=

# Los Precios (https://losprecios.co/información/api): la llave se pide por correo al autor.
LOSPRECIOS_API_KEY=
LOSPRECIOS_BASE_URL=

# Open Food Facts pide un User-Agent con nombre de la app y un contacto.
OFF_USER_AGENT=
